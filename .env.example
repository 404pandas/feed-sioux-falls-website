# Copy this file to .env and fill in real values. Never commit .env to git.
#
# Vite only exposes env vars prefixed VITE_ to the browser bundle - that's
# why these are named differently than mobile/.env's API_URL and
# STRIPE_PUBLISHABLE_KEY, even though they should hold the SAME values.
# Keep this in sync with mobile/.env by hand when either one changes.

# Same backend URL the mobile app points at.
VITE_API_URL=https://feed-sioux-falls-mobile.onrender.com

# Same Stripe publishable key the mobile app uses (starts with pk_test_ or pk_live_).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
